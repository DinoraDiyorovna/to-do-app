{
  "compilerOptions": {
    "target": "ES5",
    "lib": ["dom", "es2015"],
    "allowJs": true,
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,           
    "noImplicitAny": true,    
    "noUnusedLocals": true,   
    "noUnusedParameters": true, 
    "resolveJsonModule": true   
  },
  "include": ["src"]
}
